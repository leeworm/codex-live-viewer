{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Write|Edit|Bash|exec_command|Read|Grep|Glob|mcp__.*)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "codex-live-viewer",
            "tool": "observe",
            "timeout": 1,
            "input": {
              "phase": "before",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Write|Edit|Bash|exec_command|Read|Grep|Glob|mcp__.*)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "codex-live-viewer",
            "tool": "observe",
            "timeout": 1,
            "input": {
              "phase": "after",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      }
    ]
  }
}