{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-live-viewer",
  "version": "0.5.4",
  "description": "Automatic live code view plugin",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Live Viewer",
        "shortDescription": "Live code, diff and execution",
        "longDescription": "Automatically opens for coding work and shows local code, diff, and command execution in the current conversation.",
        "capabilities": [
          "Read",
          "Interactive"
        ]
      },
      "hooks": "./hooks/hooks.json",
      "mcpServers": "./mcp.json"
    }
  }
}